knitr::opts_chunk$set(echo = TRUE)
library(tidyverse) # data wrangling
library(broom) # for tidy model outputs
library(brms)
library(cmdstanr)
# option for Bayesian regression models:
# use all available cores for parallel computing
options(mc.cores = parallel::detectCores())
library(HDInterval) # package for credible interval computation
library(tidybayes) # plotting
library(bayesplot)
# Bayes factor
library(BayesFactor)
library(bayestestR)
# Diagnostics GUI
library(shinystan)
#current folder (first go to session -> set working directory -> to source file location)
parentfolder <- dirname(getwd())
datasets      <- paste0(parentfolder, '/8_datasets_for_statistical_analysis/') # folder with datasets for statistics
plots         <- paste0(parentfolder, '/10_plots/') # folder for saving plots
# based on explorative analysis, we are exploring acceleration, deceleration in relation with amplitude envelope and F0
# load the datasets
f0_dec <- read.csv(paste0(datasets, "/dataset_f0_dec.csv"))
f0_acc <- read.csv(paste0(datasets, "/dataset_f0_acc.csv"))
env_dec <- read.csv(paste0(datasets, "/dataset_env_dec.csv"))
env_acc <- read.csv(paste0(datasets, "/dataset_env_acc.csv"))
# this is meta information
META <- readxl::read_excel(paste0(parentfolder, "/1_primary_data_to_be_processed/info.xlsx"))
f0_dec$age <- NA
f0_dec$sex <- NA
f0_dec$first_hand <- NA
f0_acc$age <- NA
f0_acc$sex <- NA
f0_acc$first_hand <- NA
env_dec$age <- NA
env_dec$sex <- NA
env_dec$first_hand <- NA
env_acc$age <- NA
env_acc$sex <- NA
env_acc$first_hand <- NA
# loop over the rows of the df data frame
for (i in 1:nrow(f0_dec)) {
# get the participant and rhyme values for the current row
speaker <- as.character(f0_dec[i, "speaker"])
# find the rows in the info data frame that correspond to the participant value
rows <- which(META$VP == speaker)
# loop over the matching rows of the info data frame
for (j in 1:length(rows)) {
# get the current row number
row <- rows[j]
# add the values for the age, sex, dominant hand, and first hand columns to the df data frame
f0_dec[i, "age"] <- META[row, "age"]
f0_dec[i, "sex"] <- META[row, "sex"]
f0_dec[i, "first_hand"] <- META[row, "first_hand"]
}
}
# loop over the rows of the df data frame
for (i in 1:nrow(f0_acc)) {
# get the participant and rhyme values for the current row
speaker <- as.character(f0_acc[i, "speaker"])
# find the rows in the info data frame that correspond to the participant value
rows <- which(META$VP == speaker)
# loop over the matching rows of the info data frame
for (j in 1:length(rows)) {
# get the current row number
row <- rows[j]
# add the values for the age, sex, dominant hand, and first hand columns to the df data frame
f0_acc[i, "age"] <- META[row, "age"]
f0_acc[i, "sex"] <- META[row, "sex"]
f0_acc[i, "first_hand"] <- META[row, "first_hand"]
}
}
# loop over the rows of the df data frame
for (i in 1:nrow(env_dec)) {
# get the participant and rhyme values for the current row
speaker <- as.character(env_dec[i, "speaker"])
# find the rows in the info data frame that correspond to the participant value
rows <- which(META$VP == speaker)
# loop over the matching rows of the info data frame
for (j in 1:length(rows)) {
# get the current row number
row <- rows[j]
# add the values for the age, sex, dominant hand, and first hand columns to the df data frame
env_dec[i, "age"] <- META[row, "age"]
env_dec[i, "sex"] <- META[row, "sex"]
env_dec[i, "first_hand"] <- META[row, "first_hand"]
}
}
# loop over the rows of the df data frame
for (i in 1:nrow(env_acc)) {
# get the participant and rhyme values for the current row
speaker <- as.character(env_acc[i, "speaker"])
# find the rows in the info data frame that correspond to the participant value
rows <- which(META$VP == speaker)
# loop over the matching rows of the info data frame
for (j in 1:length(rows)) {
# get the current row number
row <- rows[j]
# add the values for the age, sex, dominant hand, and first hand columns to the df data frame
env_acc[i, "age"] <- META[row, "age"]
env_acc[i, "sex"] <- META[row, "sex"]
env_acc[i, "first_hand"] <- META[row, "first_hand"]
}
}
## make them as factors
f0_dec$age <- as.numeric(f0_dec$age)
f0_dec$sex <- as.factor(f0_dec$sex)
f0_dec$first_hand <- as.factor(f0_dec$first_hand)
f0_acc$age <- as.numeric(f0_acc$age)
f0_acc$sex <- as.factor(f0_acc$sex)
f0_acc$first_hand <- as.factor(f0_acc$first_hand)
env_dec$age <- as.numeric(env_dec$age)
env_dec$sex <- as.factor(env_dec$sex)
env_dec$first_hand <- as.factor(env_dec$first_hand)
env_acc$age <- as.numeric(env_acc$age)
env_acc$sex <- as.factor(env_acc$sex)
env_acc$first_hand <- as.factor(env_acc$first_hand)
f0_dec <- f0_dec %>%
mutate_at(vars(speaker, point_hand, sp_rate, rhyme, env_syllable, point_direct), as.factor) # convert as factor
#contrast coding
f0_dec <- f0_dec %>%
mutate(point_hand_s = case_when(point_hand == "_L" ~ 0.5,
point_hand == "_R" ~ -0.5)) %>%
mutate(sp_rate_s = case_when(sp_rate == "fast" ~ 0.5,
sp_rate == "normal" ~ -0.5)) %>%
mutate(point_direct_s = case_when(point_direct == "backward_movement" ~ 0.5,
point_direct == "forward_movement" ~ -0.5)) %>%
mutate(sex_s = case_when(sex == "female" ~ 0.5,
sex == "male" ~ -0.5)) %>%
mutate(first_hand_s = case_when(first_hand == "left" ~ 0.5,
first_hand == "right" ~ -0.5))
f0_acc <- f0_acc %>%
mutate_at(vars(speaker, point_hand, sp_rate, rhyme, env_syllable, point_direct), as.factor) # convert as factor
#contrast coding
f0_acc <- f0_acc %>%
mutate(point_hand_s = case_when(point_hand == "_L" ~ 0.5,
point_hand == "_R" ~ -0.5)) %>%
mutate(sp_rate_s = case_when(sp_rate == "fast" ~ 0.5,
sp_rate == "normal" ~ -0.5)) %>%
mutate(point_direct_s = case_when(point_direct == "backward_movement" ~ 0.5,
point_direct == "forward_movement" ~ -0.5)) %>%
mutate(sex_s = case_when(sex == "female" ~ 0.5,
sex == "male" ~ -0.5)) %>%
mutate(first_hand_s = case_when(first_hand == "left" ~ 0.5,
first_hand == "right" ~ -0.5))
env_dec <- env_dec %>%
mutate_at(vars(speaker, point_hand, sp_rate, rhyme, env_syllable, point_direct), as.factor) # convert as factor
#contrast coding
env_dec <- env_dec %>%
mutate(point_hand_s = case_when(point_hand == "_L" ~ 0.5,
point_hand == "_R" ~ -0.5)) %>%
mutate(sp_rate_s = case_when(sp_rate == "fast" ~ 0.5,
sp_rate == "normal" ~ -0.5)) %>%
mutate(point_direct_s = case_when(point_direct == "backward_movement" ~ 0.5,
point_direct == "forward_movement" ~ -0.5)) %>%
mutate(sex_s = case_when(sex == "female" ~ 0.5,
sex == "male" ~ -0.5)) %>%
mutate(first_hand_s = case_when(first_hand == "left" ~ 0.5,
first_hand == "right" ~ -0.5))
env_acc <- env_acc %>%
mutate_at(vars(speaker, point_hand, sp_rate, rhyme, env_syllable, point_direct), as.factor) # convert as factor
#contrast coding
env_acc <- env_acc %>%
mutate(point_hand_s = case_when(point_hand == "_L" ~ 0.5,
point_hand == "_R" ~ -0.5)) %>%
mutate(sp_rate_s = case_when(sp_rate == "fast" ~ 0.5,
sp_rate == "normal" ~ -0.5)) %>%
mutate(point_direct_s = case_when(point_direct == "backward_movement" ~ 0.5,
point_direct == "forward_movement" ~ -0.5)) %>%
mutate(sex_s = case_when(sex == "female" ~ 0.5,
sex == "male" ~ -0.5)) %>%
mutate(first_hand_s = case_when(first_hand == "left" ~ 0.5,
first_hand == "right" ~ -0.5))
# rename because sp_ is forbidden
f0_acc <- rename(f0_acc, speech_rate_s = sp_rate_s)
f0_dec <- rename(f0_dec, speech_rate_s = sp_rate_s)
env_acc <- rename(env_acc, speech_rate_s = sp_rate_s)
env_dec <- rename(env_dec, speech_rate_s = sp_rate_s)
f0_acc$wrist_apeak <- f0_acc$wrist_apeak*100*200
f0_dec$wrist_decpeak <- f0_dec$wrist_decpeak*100*200
env_acc$wrist_apeak <- env_acc$wrist_apeak*100*200
env_dec$wrist_decpeak <- env_dec$wrist_decpeak*100*200
env_dec$wrist_envpeak_dec_norm <- NA
env_dec$wrist_envpeak_dec_norm <- ave(env_dec$wrist_envpeak_dec, env_dec$speaker, FUN = function(x) scale(x, center = FALSE, scale = TRUE))
env_acc$wrist_envpeak_acc_norm <- NA
env_acc$wrist_envpeak_acc_norm <- ave(env_acc$wrist_envpeak_acc, env_acc$speaker, FUN = function(x) scale(x, center = FALSE, scale = TRUE))
# This distribution, especially the red line will be the one we will later see in the posterior predictive checks as y
hist(f0_acc$wrist_f0peak_acc, freq = FALSE, main = "Density curve")
lines(density(na.omit(f0_acc$wrist_f0peak_acc)), lwd = 2, col = 'red')
qqnorm(f0_acc$wrist_f0peak_acc)
qqline(f0_acc$wrist_f0peak_acc)
shapiro.test(f0_acc$wrist_f0peak_acc)
ks.test(f0_acc$wrist_f0peak_acc, 'pnorm')
# Bayes factor
f0acc_corr_s <- correlationBF(f0_acc$speech_rate_s, f0_acc$wrist_apeak)
describe_posterior(f0acc_corr_s)
bayesfactor(f0acc_corr_s)
# Frequentist Kendall
cor(f0_acc$speech_rate_s, f0_acc$wrist_apeak)
cor.test(f0_acc$speech_rate_s, f0_acc$wrist_apeak,  method="kendall")
f0peak_acc = readRDS(paste0(parentfolder, "/9_statistical_analysis_scripts_and_model_output/f0peak_acc_new.rds"))
f0peak_acc_pp <- pp_check(f0peak_acc, ndraws = 1000)
# This is the model output
f0peak_acc
# These are the posterior predictive checks with 1000 samples.
f0peak_acc_pp
#ggsave(file.path(plots, "f0peak_acc_pp.pdf"), plot = f0peak_acc_pp, width = 7, height = 4)
mcmc_plot(f0peak_acc, type="hist")
# Please uncomment and run this if you want to see the shinystan GUI and explore the model.
# shiny_f0peak_acc <- launch_shinystan(f0peak_acc)
posteriors_f0acc <- posterior_samples(f0peak_acc)
sum(posteriors_f0acc$b_speech_rate_s > 0) / nrow(posteriors_f0acc) # 0.9907187
sum(posteriors_f0acc$b_point_direct_s < 0) / nrow(posteriors_f0acc) # 0.9185
sum(posteriors_f0acc$b_wrist_apeak < 0) / nrow(posteriors_f0acc) # 0.8389062
sum(posteriors_f0acc$b_sex_s > 0) / nrow(posteriors_f0acc) # 1
sum(posteriors_f0acc[,6] > 0) / nrow(posteriors_f0acc) # interaction 0.7950312
# This distribution, especially the red line will be the one we will later see in the posterior predictive checks as y
hist(f0_dec$wrist_f0peak_dec, freq = FALSE, main = "Density curve")
lines(density(na.omit(f0_dec$wrist_f0peak_dec)), lwd = 2, col = 'red')
qqnorm(f0_dec$wrist_f0peak_dec)
qqline(f0_dec$wrist_f0peak_dec)
shapiro.test(f0_dec$wrist_f0peak_dec)
ks.test(f0_dec$wrist_f0peak_dec, 'pnorm')
# Bayes factor
f0dec_corr_s <- correlationBF(f0_dec$speech_rate_s, f0_dec$wrist_decpeak)
describe_posterior(f0dec_corr_s)
bayesfactor(f0dec_corr_s)
# Frequentist Kendall
cor(f0_dec$speech_rate_s, f0_dec$wrist_decpeak)
cor.test(f0_dec$speech_rate_s, f0_dec$wrist_decpeak,  method="kendall")
f0peak_dec = readRDS(paste0(parentfolder, "/9_statistical_analysis_scripts_and_model_output/f0peak_dec_new.rds"))
f0peak_dec_pp <- pp_check(f0peak_dec, ndraws = 1000)
# This is the model output
f0peak_dec
# These are the posterior predictive checks with 1000 samples.
f0peak_dec_pp
#ggsave(file.path(plots, "f0peak_dec_pp.pdf"), plot = f0peak_dec_pp, width = 7, height = 4)
plot(conditional_effects(f0peak_dec, effects = "wrist_decpeak"), points = TRUE)
mcmc_plot(f0peak_dec, type="hist")
# Please uncomment and run this if you want to see the shinystan GUI and explore the model.
# shiny_f0peak_dec <- launch_shinystan(f0peak_dec)
posteriors_f0dec <- posterior_samples(f0peak_dec)
sum(posteriors_f0dec$b_speech_rate_s > 0) / nrow(posteriors_f0dec) # 0.9784687
sum(posteriors_f0dec$b_point_direct_s < 0) / nrow(posteriors_f0dec) # 0.7204687
sum(posteriors_f0dec$b_wrist_decpeak < 0) / nrow(posteriors_f0dec) # 0.7805937
sum(posteriors_f0dec$b_sex_s > 0) / nrow(posteriors_f0dec) # 0.9999687
sum(posteriors_f0dec[,6] < 0) / nrow(posteriors_f0dec) # interaction 0.8067188
# This distribution, especially the red line will be the one we will later see in the posterior predictive checks as y
hist(env_acc$wrist_envpeak_acc_norm, freq = FALSE, main = "Density curve")
lines(density(na.omit(env_acc$wrist_envpeak_acc_norm)), lwd = 2, col = 'red')
qqnorm(env_acc$wrist_envpeak_acc_norm)
qqline(env_acc$wrist_envpeak_acc_norm)
shapiro.test(env_acc$wrist_envpeak_acc_norm) # the data is not normally distributed
ks.test(env_acc$wrist_envpeak_acc_norm, 'pnorm') # also not normally distributed
# Bayes factor
envacc_corr_s <- correlationBF(env_acc$speech_rate_s, env_acc$wrist_apeak)
describe_posterior(envacc_corr_s)
bayesfactor(envacc_corr_s)
# Frequentist Kendall
cor(env_acc$speech_rate_s, env_acc$wrist_apeak)
cor.test(env_acc$speech_rate_s, env_acc$wrist_apeak, method = "kendall")
envpeak_acc = readRDS(paste0(parentfolder, "/9_statistical_analysis_scripts_and_model_output/envpeak_acc_new.rds"))
envpeak_acc_pp <- pp_check(envpeak_acc, ndraws = 1000)
# This is the model output
envpeak_acc
# These are the posterior predictive checks with 1000 samples.
envpeak_acc_pp
#ggsave(file.path(plots, "envpeak_acc_pp.pdf"), plot = envpeak_acc_pp, width = 7, height = 4)
plot(conditional_effects(envpeak_acc, effects = "wrist_apeak"), points = TRUE)
mcmc_plot(envpeak_acc, type="hist")
# Please uncomment and run this if you want to see the shinystan GUI and explore the model.
# shiny_envpeak_acc <- launch_shinystan(envpeak_acc)
posteriors_mdl_env_acc <- posterior_samples(envpeak_acc)
sum(posteriors_mdl_env_acc$b_speech_rate_s < 0) / nrow(posteriors_mdl_env_acc) # 0.8616563
sum(posteriors_mdl_env_acc$b_point_direct_s < 0) / nrow(posteriors_mdl_env_acc) # 0.8878438
sum(posteriors_mdl_env_acc$b_wrist_apeak > 0) / nrow(posteriors_mdl_env_acc) # 0.9010625
sum(posteriors_mdl_env_acc$b_sex_s > 0) / nrow(posteriors_mdl_env_acc) # 0.8140312
sum(posteriors_mdl_env_acc[,6] > 0) / nrow(posteriors_mdl_env_acc) # interaction 0.7585625
# This distribution, especially the red line will be the one we will later see in the posterior predictive checks as y
hist(env_dec$wrist_envpeak_dec_norm, freq = FALSE, main = "Density curve")
lines(density(na.omit(env_dec$wrist_envpeak_dec_norm)), lwd = 2, col = 'red')
qqnorm(env_dec$wrist_envpeak_dec_norm)
qqline(env_dec$wrist_envpeak_dec_norm) # not normal
shapiro.test(env_dec$wrist_envpeak_dec_norm) # the data is not normally distributed
ks.test(env_dec$wrist_envpeak_dec_norm, 'pnorm') # also not normally distributed
# Bayes factor
envdec_corr_s <- correlationBF(env_dec$speech_rate_s, env_dec$wrist_decpeak)
describe_posterior(envdec_corr_s)
bayesfactor(envdec_corr_s)
# Frequentist Kendall
cor(env_dec$speech_rate_s, env_dec$wrist_decpeak)
cor.test(env_dec$speech_rate_s, env_dec$wrist_decpeak, method = "kendall")
envpeak_dec = readRDS(paste0(parentfolder, "/9_statistical_analysis_scripts_and_model_output/envpeak_dec_new.rds"))
envpeak_dec_pp <- pp_check(envpeak_dec, ndraws = 1000)
# This is the model output
envpeak_dec
# These are the posterior predictive checks with 1000 samples.
envpeak_dec_pp
#ggsave(file.path(plots, "envpeak_dec_pp.pdf"), plot = envpeak_dec_pp, width = 7, height = 4)
plot(conditional_effects(envpeak_dec, effects = "wrist_decpeak"), points = TRUE)
mcmc_plot(envpeak_dec, type="hist")
# Please uncomment and run this if you want to see the shinystan GUI and explore the model.
# shiny_envpeak_dec <- launch_shinystan(envpeak_dec)
posteriors_mdl_env_dec <- posterior_samples(envpeak_dec)
sum(posteriors_mdl_env_dec$b_speech_rate_s < 0) / nrow(posteriors_mdl_env_dec) # 0.9429062 -- almost!
sum(posteriors_mdl_env_dec$b_point_direct_s < 0) / nrow(posteriors_mdl_env_dec) # 0.9415938 -- almost!
sum(posteriors_mdl_env_dec$b_wrist_decpeak < 0) / nrow(posteriors_mdl_env_dec) # 0.9900625
sum(posteriors_mdl_env_dec$b_sex_s > 0) / nrow(posteriors_mdl_env_dec) # 0.790375
sum(posteriors_mdl_env_dec[,6] < 0) / nrow(posteriors_mdl_env_dec) # interaction 0.68525
sum(posteriors_mdl_env_dec$b_speech_rate_s < 0) / nrow(posteriors_mdl_env_dec) # 0.973875
# exact estimates, no rounding
fixef(f0peak_dec)["wrist_decpeak", ]
fixef(envpeak_dec)["wrist_decpeak", ]
dr_f0  <- as_draws_df(f0peak_dec)
dr_env <- as_draws_df(envpeak_dec)
b_f0   <- -dr_f0$b_wrist_decpeak    # minus: positive = stronger deceleration -> higher outcome
b_env  <- -dr_env$b_wrist_decpeak
summ <- function(x) round(c(mean = mean(x), quantile(x, c(.025, .975))), 3)
# 1. certainty: how many posterior SDs from zero (unit-free)
c(f0 = mean(b_f0) / sd(b_f0), env = mean(b_env) / sd(b_env))
# 2. size: % change of the outcome per 1 cm/s^2 stronger deceleration
rel_f0  <- b_f0  / mean(f0peak_dec$data$wrist_f0peak_dec)        * 100
rel_env <- b_env / mean(envpeak_dec$data$wrist_envpeak_dec_norm) * 100
rbind(f0 = summ(rel_f0), env = summ(rel_env))
# 3. size: per 1 SD of deceleration, in residual SDs of the outcome
std_f0  <- b_f0  * sd(f0peak_dec$data$wrist_decpeak)  / dr_f0$sigma
std_env <- b_env * sd(envpeak_dec$data$wrist_decpeak) / dr_env$sigma
rbind(f0 = summ(std_f0), env = summ(std_env))
# difference envelope - F0 and Pr(envelope effect > F0 effect)
set.seed(123)
n <- min(length(b_f0), length(b_env))
d_rel <- rel_env[1:n] - sample(rel_f0, n)
d_std <- std_env[1:n] - sample(std_f0, n)
rbind(rel = summ(d_rel), std = summ(d_std))
c(P_rel = mean(d_rel > 0), P_std = mean(d_std > 0))
peak_summary <- function(df, var, name) {
x <- df[[var]]
data.frame(dataset = name, peak = var,
n = sum(!is.na(x)),
mean = mean(x, na.rm = TRUE),
mean_abs = mean(abs(x), na.rm = TRUE),
sd = sd(x, na.rm = TRUE),
median_abs = median(abs(x), na.rm = TRUE))
}
peaks <- rbind(
peak_summary(f0_acc,  "wrist_apeak",   "f0_acc"),
peak_summary(env_acc, "wrist_apeak",   "env_acc"),
peak_summary(f0_dec,  "wrist_decpeak", "f0_dec"),
peak_summary(env_dec, "wrist_decpeak", "env_dec")
)
peaks[, 3:7] <- round(peaks[, 3:7], 2)
peaks
